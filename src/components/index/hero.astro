<div class="bg-gray-900 flex flex-col items-center">
    <div class="w-full px-8 pt-24 pb-0 flex flex-col items-center gap-6 max-w-[900px]">
        <h2 class="text-6xl font-bold text-[#f4a6b8] text-center leading-tight">
            MicroNote in your area.<br />
            Faster. Lighter. Your second memory.
        </h2>
        <p class="text-white/60 text-base text-center">
            A local-first, open-source workspace for Vimmers.<br />
            Notes, tasks, and projects — simple, fast, and yours.
        </p>

        <div class="flex gap-1 mt-4">
            <button
                class="tab-btn px-4 py-1.5 rounded-md text-sm font-medium text-white bg-white/15 transition-colors"
                data-target="panel-notes"
            >
                Notes
            </button>
            <button
                class="tab-btn px-4 py-1.5 rounded-md text-sm font-medium text-white/40 hover:text-white/70 transition-colors"
                data-target="panel-issues"
            >
                Issues
            </button>
        </div>
    </div>

    <div class="w-full max-w-[960px] px-8 pt-8">
        <div id="panel-notes" class="tab-panel w-full rounded-xl overflow-hidden border border-white/10 shadow-2xl">
            <img src="/screenshot-notes.png" alt="Notes screen" class="w-full block" />
        </div>
        <div id="panel-issues" class="tab-panel w-full rounded-xl overflow-hidden border border-white/10 shadow-2xl hidden">
            <img src="/screenshot-issues.png" alt="Issues screen" class="w-full block" />
        </div>
    </div>
</div>

<script>
    const buttons = document.querySelectorAll<HTMLButtonElement>(".tab-btn");
    const panels = document.querySelectorAll<HTMLElement>(".tab-panel");

    buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
            const target = btn.dataset.target!;

            panels.forEach((p) => p.classList.add("hidden"));
            document.getElementById(target)!.classList.remove("hidden");

            buttons.forEach((b) => {
                b.classList.remove("bg-white/15", "text-white");
                b.classList.add("text-white/40");
            });
            btn.classList.add("bg-white/15", "text-white");
            btn.classList.remove("text-white/40");
        });
    });
</script>
