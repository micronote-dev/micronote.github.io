---
import { BookOpen, Github } from "lucide-astro";
---

<header class="flex items-center justify-between py-4 px-8 bg-white border-b border-black/8">
    <a href="/" class="flex items-center gap-3">
        <img src="/appicon.png" alt="Micro Note icon" class="w-9 h-9 rounded-[22%] shadow-md shadow-black/20" />
        <img src="/appname.png" alt="Micro Note" class="h-7 w-auto" />
    </a>
    <nav class="flex items-center">
        <ul class="flex items-center gap-1">
            <li>
                <a href="/docs" class="flex items-center gap-1.5 px-3 py-1.5 rounded-md text-gray-500 hover:text-gray-900 hover:bg-black/5 transition-colors text-sm">
                    <BookOpen size={15} />
                    Docs
                </a>
            </li>
            <li>
                <a href="https://github.com/micronote-dev/micronote" class="flex items-center gap-1.5 px-3 py-1.5 rounded-md text-gray-500 hover:text-gray-900 hover:bg-black/5 transition-colors text-sm">
                    <Github size={15} />
                    GitHub
                </a>
            </li>
            <li>
                <a href="/download" class="flex items-center gap-1.5 px-4 py-1.5 rounded-md bg-gray-900 text-white hover:bg-gray-700 transition-colors text-sm font-medium">
                    Download
                </a>
            </li>
        </ul>
    </nav>
</header>
